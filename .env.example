# Public browser config only. Never put secrets here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Server-side only (Supabase Edge Function secrets, never VITE_):
# NESSIE_API_KEY — set via: supabase secrets set NESSIE_API_KEY=...
# APP_ORIGIN — production origin allowed for CORS, e.g. https://your-app.vercel.app
